#!/bin/sh
set -u

me=throwaway-pg
image=docker.io/library/postgres:16-alpine
allowlist='PATH LANG LC_ALL TZ TERM'
go_allowlist='GOCACHE GOMODCACHE GOPATH'
go_fixed='GOPROXY=off GOFLAGS=-mod=readonly'
ready_attempts=60

usage() {
	echo "usage: $me --env NAME [--image IMAGE] -- command [argument ...]" >&2
	exit 2
}

fail() {
	echo "$me: $*" >&2
	exit 1
}

target=
while [ "$#" -gt 0 ]; do
	case $1 in
	--env)
		[ "$#" -ge 2 ] || usage
		target=$2
		shift 2
		;;
	--image)
		[ "$#" -ge 2 ] || usage
		image=$2
		shift 2
		;;
	--)
		shift
		break
		;;
	*)
		usage
		;;
	esac
done
[ "$#" -gt 0 ] || usage
[ -n "$target" ] || usage
[ -n "$image" ] || usage

case $target in
'' | [0-9]* | *[!A-Za-z0-9_]*)
	fail "--env takes a variable name, not '$target'"
	;;
esac
for reserved in $allowlist $go_allowlist GOPROXY GOFLAGS HOME TMPDIR; do
	[ "$target" = "$reserved" ] && fail "--env $target would replace a variable the runner sets itself"
done

readable_untracked='
for candidate do
	[ -d "$candidate" ] && continue
	[ -r "$candidate" ] || continue
	git -C "$(dirname "$candidate")" ls-files --error-unmatch -- "$(basename "$candidate")" >/dev/null 2>&1 && continue
	printf "%s\n" "$candidate"
done
'

rundir=$(pwd -P) || fail "cannot resolve the current directory"

found=$(find "$rundir" -name .git -prune -o \
	\( -name .env -o -name '.env.*' -o -name '*.env' -o -name .envrc \) \
	-exec sh -c "$readable_untracked" sh {} + 2>/dev/null)

dir=$rundir
while [ "$dir" != / ]; do
	dir=$(dirname "$dir")
	[ "$dir" = / ] && prefix= || prefix=$dir
	more=$(sh -c "$readable_untracked" sh "$prefix"/.env "$prefix"/.envrc "$prefix"/.env.* "$prefix"/*.env "$prefix"/.*.env)
	[ -n "$more" ] && found="$found
$more"
done

found=$(printf '%s\n' "$found" | sed '/^$/d')
if [ -n "$found" ]; then
	{
		echo "$me: refusing to run: these env files are readable from here and git does not track them:"
		printf '%s\n' "$found" | sed 's/^/  /'
		echo "Move them out of this directory's tree and its ancestors, or make them unreadable to this user, and run again."
	} >&2
	exit 1
fi

if command -v go >/dev/null 2>&1; then
	go_values=$(cd / && GOTOOLCHAIN=local go env $go_allowlist 2>/dev/null) || go_values=
else
	go_values=
fi

podman() {
	command podman --cgroup-manager=cgroupfs "$@"
}

if ! podman image exists "$image" >/dev/null 2>&1; then
	fail "image $image is not present, and this runner never pulls. Pull it yourself with: podman pull $image"
fi

suffix=$(od -An -N6 -tx1 /dev/urandom | tr -d ' \n')
name="throwaway-pg-$$-$suffix"
password=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
[ -n "$suffix" ] && [ -n "$password" ] || fail "cannot read /dev/urandom"

child=
workdir=
started=

cleanup() {
	status=$?
	trap '' INT TERM HUP
	if [ -n "$child" ]; then
		kill -TERM "$child" 2>/dev/null
		wait "$child" 2>/dev/null
	fi
	[ -n "$started" ] && podman rm -f "$name" >/dev/null 2>&1
	[ -n "$workdir" ] && rm -rf "$workdir"
	exit "$status"
}

on_signal() {
	if [ -n "$child" ]; then
		kill -TERM "$child" 2>/dev/null
		wait "$child" 2>/dev/null
		child=
	fi
	exit "$1"
}

trap cleanup EXIT
trap 'on_signal 129' HUP
trap 'on_signal 130' INT
trap 'on_signal 143' TERM

workdir=$(mktemp -d) || fail "cannot create a temporary directory"
mkdir "$workdir/home" "$workdir/tmp" || fail "cannot create HOME and TMPDIR under $workdir"

started=1
podman run -d --pull=never --userns=host --name "$name" \
	-e POSTGRES_PASSWORD="$password" \
	-p 127.0.0.1::5432 "$image" >/dev/null || fail "podman could not start $name from $image"

port=$(podman port "$name" 5432/tcp | sed -n 's/^127\.0\.0\.1:\([0-9][0-9]*\)$/\1/p' | head -n 1)
[ -n "$port" ] || fail "$name published no port on 127.0.0.1"

attempts=0
until podman exec "$name" pg_isready -q -U postgres -h 127.0.0.1 >/dev/null 2>&1; do
	attempts=$((attempts + 1))
	if [ "$attempts" -ge "$ready_attempts" ]; then
		podman logs "$name" 2>&1 | tail -n 20 >&2
		fail "$name did not accept connections within $ready_attempts seconds"
	fi
	sleep 1
done

dsn="postgres://postgres:$password@127.0.0.1:$port/postgres?sslmode=disable"

set -- "$target=$dsn" "HOME=$workdir/home" "TMPDIR=$workdir/tmp" "$@"
for assignment in $go_fixed; do
	set -- "$assignment" "$@"
done
for variable in $allowlist; do
	eval "isset=\${$variable+x}"
	[ -n "$isset" ] || continue
	eval "value=\$$variable"
	set -- "$variable=$value" "$@"
done
if [ -n "$go_values" ]; then
	index=0
	for variable in $go_allowlist; do
		index=$((index + 1))
		value=$(printf '%s\n' "$go_values" | sed -n "${index}p")
		[ -n "$value" ] && set -- "$variable=$value" "$@"
	done
fi

echo "$me: running against $name on 127.0.0.1:$port as $target" >&2
env -i "$@" <&0 &
child=$!
wait "$child"
status=$?
child=
exit "$status"
