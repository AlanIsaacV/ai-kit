#!/usr/bin/env python3

import argparse
import os
import shutil
import sys
from pathlib import Path

from install_support import agent_definitions, link_problem


def main():
    parser = argparse.ArgumentParser()
    for option in ("repo", "bin", "bin-link", "runner", "runner-link", "claude-link", "skills-dir", "agents-dir", "build-dir"):
        parser.add_argument(f"--{option}", type=Path, required=True)
    args = parser.parse_args()
    failures = []
    links = [(args.bin_link, args.bin), (args.runner_link, args.runner), (args.claude_link, args.repo)]
    for skill in sorted((args.repo / "skills").glob("*/SKILL.md")):
        links.append((args.skills_dir / f"ai-kit-{skill.parent.name}", skill.parent))
    try:
        definitions = list(agent_definitions(args.repo.resolve(), args.build_dir.resolve()))
        if not definitions:
            failures.append("no agent contracts found")
        for name, wrapper, content in definitions:
            links.append((args.agents_dir / f"{name}.toml", wrapper))
            try:
                if wrapper.read_text(encoding="utf-8") != content:
                    failures.append(f"{wrapper}: agent definition is stale or modified")
            except (OSError, UnicodeError) as error:
                failures.append(f"{wrapper}: cannot read agent definition ({error})")
    except (OSError, ValueError, KeyError) as error:
        failures.append(f"cannot inspect agent contracts: {error}")
    for link, target in links:
        problem = link_problem(link, target)
        if problem:
            failures.append(problem)
    if not args.bin.is_file() or not os.access(args.bin, os.X_OK):
        failures.append(f"{args.bin}: memory binary is missing or not executable")
    if not args.runner.is_file() or not os.access(args.runner, os.X_OK):
        failures.append(f"{args.runner}: throwaway-pg runner is missing or not executable")
    for required in (args.repo / "runtime.md", args.repo / ".claude-plugin" / "plugin.json"):
        if not required.is_file():
            failures.append(f"{required}: required runtime or plugin file is missing")
    for name, installed, link in (("memory", args.bin, args.bin_link), ("throwaway-pg", args.runner, args.runner_link)):
        command = shutil.which(name)
        if command is None:
            failures.append(f"{name} is not on PATH; add {link.parent} to your shell PATH")
            continue
        try:
            if Path(command).resolve(strict=True) != installed.resolve(strict=True):
                failures.append(f"PATH resolves {name} to {command}, not this installation; place {link.parent} first on PATH")
        except (OSError, RuntimeError) as error:
            failures.append(f"cannot resolve {name} on PATH: {error}")
    command = shutil.which("memory")
    for failure in failures:
        print(f"error: {failure}", file=sys.stderr)
    if failures:
        print("Repair installation files with make install using the same directory overrides; preserve or move any conflicting real files first. Apply any PATH fix above, then rerun make doctor.", file=sys.stderr)
        return 1
    print(f"Installation healthy: memory, throwaway-pg, Claude plugin, {len(links) - len(definitions) - 3} Codex skills and {len(definitions)} Codex agents; memory resolves to {command}.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
