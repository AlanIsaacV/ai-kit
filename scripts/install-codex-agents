#!/usr/bin/env python3

import argparse
import sys
from pathlib import Path

from install_support import agent_definitions, link_problem


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--repo", type=Path, required=True)
    parser.add_argument("--agents-dir", type=Path, required=True)
    parser.add_argument("--build-dir", type=Path, required=True)
    args = parser.parse_args()
    failures = []
    try:
        args.agents_dir.mkdir(parents=True, exist_ok=True)
        args.build_dir.mkdir(parents=True, exist_ok=True)
        definitions = list(agent_definitions(args.repo.resolve(), args.build_dir.resolve()))
    except (OSError, ValueError, KeyError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    for name, wrapper, content in definitions:
        link = args.agents_dir / f"{name}.toml"
        try:
            if link.exists() and not link.is_symlink():
                raise ValueError(f"{link} is a real file or directory; nothing was linked there")
            if wrapper.is_symlink():
                raise ValueError(f"{wrapper} is a symlink; refusing to overwrite its target")
            wrapper.write_text(content, encoding="utf-8")
            if link.is_symlink():
                link.unlink()
            link.symlink_to(wrapper)
            problem = link_problem(link, wrapper)
            if problem:
                raise ValueError(problem)
            print(f"{link} -> {wrapper}")
        except (OSError, ValueError) as error:
            failures.append(str(error))
    for error in failures:
        print(f"error: {error}", file=sys.stderr)
    return bool(failures)


if __name__ == "__main__":
    sys.exit(main())
