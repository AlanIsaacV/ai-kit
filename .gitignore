# Working memory the assistant writes for itself. These are local by design:
# the real work lands in the code, nobody reviews them by hand, and committing
# them only adds noise to pull requests.
plans/
.ai-kit/

# Build output
/bin/

# Bytecode left behind by the Python scripts `make check` runs
__pycache__/

# Per-machine host settings. The shared .claude/settings.json is committable;
# this one holds one person's permission grants and absolute paths.
.claude/settings.local.json

.verify-tmp/
